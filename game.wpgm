import wollok.game.*
import granja.*
import src.cultivos.Maiz
import src.cultivos.Trigo
import src.cultivos.Tomaco

program lagranja {
	//  CONFIG	
	game.title("La granja")
	game.height(10)
	game.width(10)
	game.ground("fondo.png")

	game.addVisual(mercado)
 	game.addVisualCharacter(personaje)
 	
	keyboard.g().onPressDo({ personaje.cambiarGenero() })
	keyboard.m().onPressDo({ personaje.plantar(new Maiz()) })
	keyboard.t().onPressDo({ personaje.plantar(new Trigo()) })
	keyboard.o().onPressDo({ personaje.plantar(new Tomaco()) })
	keyboard.r().onPressDo({ personaje.regar()})
	keyboard.c().onPressDo({ personaje.cosechar() })
	keyboard.space().onPressDo({ game.say(personaje, personaje.cuantoPuedoVender()) })
	
	//keyboard.space().onPressDo({personaje.cuantoPuedoVender2() }) //no anda

	game.onCollideDo(mercado, {personaje => personaje.vender()})

 	//  COMIENZA
	game.start()
}
